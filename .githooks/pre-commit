#!/usr/bin/env bash
# Reject commits that are not authored as pei76.
set -euo pipefail

expected_name="pei76"
expected_email="jiaqipei76@gmail.com"

name=$(git config --local --get user.name || true)
email=$(git config --local --get user.email || true)

# Prefer env overrides used by CI/sync, else local config, else global
author_name="${GIT_AUTHOR_NAME:-$name}"
author_email="${GIT_AUTHOR_EMAIL:-$email}"
if [[ -z "$author_name" ]]; then author_name=$(git config --get user.name || true); fi
if [[ -z "$author_email" ]]; then author_email=$(git config --get user.email || true); fi

if [[ "$author_name" != "$expected_name" || "$author_email" != "$expected_email" ]]; then
  echo "ERROR: hashlayer-labs commits must use:"
  echo "  user.name  = $expected_name"
  echo "  user.email = $expected_email"
  echo "Current:"
  echo "  user.name  = ${author_name:-<empty>}"
  echo "  user.email = ${author_email:-<empty>}"
  echo "Fix:"
  echo "  git config --local user.name \"$expected_name\""
  echo "  git config --local user.email \"$expected_email\""
  exit 1
fi
