#!/usr/bin/env bash
# Allow only the rotating public-maintainer identities (see allowed-authors).
# Block peijiaqi / dogelayer emails.
set -euo pipefail

hooks_dir=$(cd "$(dirname "$0")" && pwd)
allow_file="$hooks_dir/allowed-authors"

name=$(git config --local --get user.name || true)
email=$(git config --local --get user.email || true)
author_name="${GIT_AUTHOR_NAME:-$name}"
author_email="${GIT_AUTHOR_EMAIL:-$email}"
if [[ -z "$author_name" ]]; then author_name=$(git config --get user.name || true); fi
if [[ -z "$author_email" ]]; then author_email=$(git config --get user.email || true); fi

# Hard denylist (dogelayer / personal mix-ups)
deny_pat='peijiaqi|peijiaq|1278017494@qq\.com|jiaqipei76@gmail\.com'
if echo "${author_name} ${author_email}" | grep -Eiq "$deny_pat"; then
  echo "ERROR: forbidden author identity (peijiaqi / dogelayer / personal mix-up)."
  echo "  name=${author_name:-<empty>} email=${author_email:-<empty>}"
  echo "Use one of the identities in .githooks/allowed-authors"
  exit 1
fi

ok=0
while IFS='|' read -r allowed_name allowed_email; do
  [[ -z "${allowed_name:-}" || "$allowed_name" =~ ^# ]] && continue
  if [[ "$author_name" == "$allowed_name" && "$author_email" == "$allowed_email" ]]; then
    ok=1
    break
  fi
done < "$allow_file"

if [[ "$ok" -ne 1 ]]; then
  echo "ERROR: author must be one of (.githooks/allowed-authors):"
  grep -v '^#' "$allow_file" | grep -v '^$' | sed 's/^/  /'
  echo "Current: ${author_name:-<empty>} <${author_email:-<empty>}>"
  echo "Pick one, e.g.:"
  first=$(grep -v '^#' "$allow_file" | grep -v '^$' | head -1)
  echo "  git config --local user.name \"${first%%|*}\""
  echo "  git config --local user.email \"${first##*|}\""
  exit 1
fi
