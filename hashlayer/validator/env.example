#=====================================================================
# Bittensor Configuration
# Set NETUID when the HashLayer subnet ID is announced / assigned to you.
NETUID=<your_subnet_netuid>
SUBTENSOR_NETWORK=finney
BT_WALLET_NAME="your_wallet_name"
BT_WALLET_HOTKEY="default"


#=====================================================================
# Subnet Proxy Configuration (for regular validators)
# Contact HashLayer maintainers for these credentials
SUBNET_PROXY_API_URL="http://your-proxy-host:8888"
SUBNET_PROXY_API_TOKEN="your_api_token"


#=====================================================================
# Subnet Owner Configuration (ONLY for subnet owner)
# WARNING: These parameters are ONLY for the subnet owner.
# Regular validators should LEAVE THESE COMMENTED OUT.
#
# PROXY_DOMAIN="stratum.hashlayer.ai"
# PROXY_PORT="3331"
# PROXY_HIGH_DIFF_PORT="3332"
# PROXY_API_PORT="8888"
# PROXY_USERNAME="your_pool_user"
# PROXY_PASSWORD="x"
# PROXY_API_TOKEN="your_api_token"


#=====================================================================
# Optional: Database submission
SUBMIT_VALIDATOR_INFO=true
DB_SUBMIT_INTERVAL_SECONDS=300
LOGGING_LEVEL=info


#=====================================================================
# Recovery Configuration
RECOVERY_FILE_PATH=~/.bittensor/data/hashlayer/validator
RECOVERY_FILE_NAME=validator_state.json
